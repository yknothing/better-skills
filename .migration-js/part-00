#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");

const ROOT = process.cwd();
const PREFIX = "bs-";
const selfSkills = [
  "requirements-engineering", "first-customer-finder", "visual-design", "prose-craft",
  "dev-flow", "skill-health", "skill-bootstrap", "social-card", "article-illustrate",
];
const externalSkills = [
  "brainstorming", "pptx", "grill-me", "grilling", "writing-great-skills",
  "learn-skill", "emil-design-eng", "review-animations", "animation-vocabulary",
];
const allSkills = [...selfSkills, ...externalSkills];
const aliases = Object.fromEntries(allSkills.map((name) => [name, PREFIX + name]));

function abs(rel) { return path.join(ROOT, rel); }
function read(rel) { return fs.readFileSync(abs(rel), "utf8"); }
function write(rel, content) {
  fs.mkdirSync(path.dirname(abs(rel)), { recursive: true });
  fs.writeFileSync(abs(rel), content.endsWith("\n") ? content : content + "\n", "utf8");
}
function writeBase64(rel, data) { write(rel, Buffer.from(data, "base64").toString("utf8")); }
function replaceOrThrow(rel, before, after) {
  const current = read(rel);
  if (!current.includes(before)) throw new Error(`expected block not found in ${rel}: ${before.slice(0, 120)}`);
  write(rel, current.replace(before, after));
}
function escapeRe(value) { return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }
function replaceNames(text, names) {
  let out = text;
  for (const oldName of [...names].sort((a, b) => b.length - a.length)) {
    const re = new RegExp(`(?<![A-Za-z0-9-])${escapeRe(oldName)}(?![A-Za-z0-9-])`, "g");
    out = out.replace(re, aliases[oldName]);
  }
  return out;
}
function replaceExternalRefs(text) {
  let out = text;
  for (const oldName of [...externalSkills].sort((a, b) => b.length - a.length)) {
    const canonical = aliases[oldName];
    const escaped = escapeRe(oldName);
    const patterns = [
      [new RegExp("`" + escaped + "`", "g"), "`" + canonical + "`"],
      [new RegExp("'" + escaped + "'", "g"), "'" + canonical + "'"],
      [new RegExp('"' + escaped + '"', "g"), '"' + canonical + '"'],
      [new RegExp("/" + escaped + "(?![A-Za-z0-9-])", "g"), "/" + canonical],
      [new RegExp("\\$" + escaped + "(?![A-Za-z0-9-])", "g"), "$" + canonical],
      [new RegExp("(add|update|remove|validate) " + escaped + "(?![A-Za-z0-9-])", "g"), `$1 ${canonical}`],
    ];
    for (const [re, replacement] of patterns) out = out.replace(re, replacement);
  }
  return out;
}
function isTextFile(file) {
  return /\.(md|js|json|sh|yaml|yml|txt|html|css|ts|tsx|jsx)$/i.test(file) || path.basename(file) === "CLAUDE.md";
}
function walk(dir, out = []) {
  if (!fs.existsSync(dir)) return out;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if ([".git", "node_modules", ".cache"].includes(entry.name)) continue;
    const p = path.join(dir, entry.name);
    if (entry.isDirectory()) walk(p, out);
    else if (entry.isFile()) out.push(p);
  }
  return out;
}
function renameDir(oldRel, newRel) {
  const oldPath = abs(oldRel), newPath = abs(newRel);
  if (!fs.existsSync(oldPath)) {
    if (fs.existsSync(newPath)) return;
    throw new Error(`missing rename source: ${oldRel}`);
  }
  if (fs.existsSync(newPath)) throw new Error(`rename target already exists: ${newRel}`);
  fs.renameSync(oldPath, newPath);
}

for (const name of selfSkills) {
  renameDir(`skills/${name}`, `skills/${PREFIX}${name}`);
  renameDir(`docs/reviews/${name}`, `docs/reviews/${PREFIX}${name}`);
}

const registry = JSON.parse(read("skills.json"));
registry.version = "0.2.0-dev";
registry.namespace = {
  prefix: PREFIX,
  policy: "All public Better-Skills IDs use the bs- prefix.",
  legacy_aliases: "Deprecated; remove after one migration release and a clean compatibility review.",
};
